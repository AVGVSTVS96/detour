{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["data/.cache/**", "public/roads/**"],
  "printWidth": 80,
  "proseWrap": "never",
  "sortImports": { "ignoreCase": true, "newlinesBetween": true },
  "sortPackageJson": true,
  "sortTailwindcss": { "stylesheet": "./app/globals.css" },
  "trailingComma": "es5"
}
