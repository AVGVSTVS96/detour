{
  "name": "detour",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/ && next dev",
    "build": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/ && next build",
    "data": "bun data/build.ts",
    "check": "next typegen && oxlint && oxfmt --check && tsc",
    "fix": "oxlint --fix; oxfmt",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "8.0.2"
  }
}
